# ---------------------------------------------------------------------------
# Aesthetic OS configuration. Copy to .env.local and fill in.
# Leave NEXT_PUBLIC_SUPABASE_URL empty (or DEMO_MODE=true) to run the demo sandbox.
# NEVER commit real values. Server-only secrets have no NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Public URL of the app (used in reminder links and calendar files)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo sandbox: in-memory, per-visitor, seeded with a lash studio. No real data.
DEMO_MODE=false

# Supabase (Postgres + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only: cron, account deletion, token custody

# Signs the demo-session cookie. 32+ random characters: openssl rand -base64 48
SESSION_SECRET=

# AES-256-GCM keys for OAuth tokens, "keyId:base64(32 bytes)". First key encrypts; list
# older keys after it to rotate. Generate: echo "k1:$(openssl rand -base64 32)"
TOKEN_ENCRYPTION_KEYS=

# Shared secret for the reminder worker (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Optional AI (Claude). Without a key, Muse uses its free built-in engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_PROVIDER=                          # set to "local" to force the built-in engine

# Optional Web Push reminders: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@yourdomain.com

# Optional email reminders (Resend free tier works)
RESEND_API_KEY=
EMAIL_FROM=

# Shown in the privacy policy and terms
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# Phase 2 direct publishing (only needed for token revocation calls today)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
